# Meme Collector Agent configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=./data/meme_collector.sqlite3
# Optional Docker build base image override, useful on hosts where Docker Hub is slow/unavailable.
BASE_IMAGE=python:3.12-slim
# Optional Docker build pip index override, useful on China mainland ECS hosts.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=
OPENAI_PROXY=
ANYSEARCH_API_KEY=
ANYSEARCH_MCP_URL=https://api.anysearch.com/mcp
ANYSEARCH_PROXY=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=
DIFY_API_KEY=
DIFY_PROXY=
# Testing only: skip Dify preflight/listing during collection dry-runs.
# Does not affect approved writes, which still require real Dify credentials.
DIFY_SKIP_CHECK_FOR_DRY_RUN=false
